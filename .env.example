# Email provider (Brevo SMTP relay or API key)
# Either set BREVO_API_KEY for the Brevo HTTP API, or set SMTP_* values for SMTP relay.
# Set EMAIL_PROVIDER=brevo or EMAIL_PROVIDER=smtp to force a specific provider.
# EMAIL_PROVIDER=
# BREVO_API_KEY=
# BREVO_SENDER_NAME=VM Portal
# BREVO_SENDER_EMAIL=no-reply@example.com
# SMTP_SERVER=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=ae9633001@smtp-brevo.com
# SMTP_PASSWORD=
# SMTP_USE_TLS=True

# Logging
LOG_LEVEL=INFO
